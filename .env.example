# Diploma_web - credenciales locales compartidas por frontend y backend.
# Copia este archivo como .env en la raiz del repositorio.
# Nunca publiques .env en GitHub ni compartas SUPABASE_SERVICE_ROLE_KEY.
#
# Supabase Dashboard > Project Settings > API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API local
PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Opcional: necesario para subir imagenes y fuentes a Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
